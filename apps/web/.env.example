# Validation Copilot — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to version control

# ── AI Providers ──────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
# Use a PAID key for the demo — free tier will 429 mid-demo (Section 6.1)
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://console.groq.com
# Used for routing/classification (Section 6.2)
GROQ_API_KEY=your_groq_api_key_here
# Optional model overrides (defaults are the verified stable IDs below)
# GEMINI_PLANNER_MODEL=gemini-2.5-flash
# GEMINI_VERIFIER_MODEL=gemini-2.5-flash
# GROQ_ROUTER_MODEL=llama-3.3-70b-versatile

# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
# NOTE: NEXT_PUBLIC_* vars are exposed to the browser (anon key only).
# SERVICE_ROLE_KEY must NEVER have NEXT_PUBLIC_ prefix — server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Email (P1 only — not needed for P0 demo) ─────────────────
# EMAIL_PROVIDER_API_KEY=your_resend_or_sendgrid_key_here

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
