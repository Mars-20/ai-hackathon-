# Validation Copilot — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to version control

# ── AI Providers ──────────────────────────────────────────────
# Get from: https://aistudio.google.com/apikey
# Use a PAID key for the demo — free tier will 429 mid-demo (Section 6.1)
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://console.groq.com
# Used for routing/classification (Section 6.2)
GROQ_API_KEY=your_groq_api_key_here
# Optional model overrides (defaults are the verified stable IDs below)
# GEMINI_PLANNER_MODEL=gemini-2.5-flash
# GEMINI_VERIFIER_MODEL=gemini-2.5-flash
# GROQ_ROUTER_MODEL=llama-3.3-70b-versatile

# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
# NOTE: NEXT_PUBLIC_* vars are exposed to the browser (anon key only).
# SERVICE_ROLE_KEY must NEVER have NEXT_PUBLIC_ prefix — server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Rate limit (Upstash Redis — prod) ──────────────────────────
# When set, checkRateLimit() uses shared Redis sliding-window via a single
# atomic Lua EVAL (lib/rate-limit.ts). When unset, in-memory per-instance
# fallback (dev/test only — NOT shared, lost on restart). Never commit values.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── Email (P1 only — not needed for P0 demo) ─────────────────
# Provider pick (Task 6): Resend. SendGrid deferred — no account created,
# no keys issued (human/outside-worktree step). Delivery wiring is
# out-of-scope in v1 (see apps/web/src/app/api/workspace/invite/route.ts
# NOTE); this key is consumed when delivery is wired.
# RESEND_API_KEY=your_resend_key_here

# ── Assistant chat (v1) ────────────────────────────────────────
# Daily per-user assistant message budget. Server enforces via the atomic
# consume_assistant_message RPC; exhausted → 402 + plans_url + Retry-After
# (seconds to UTC midnight). Default 50 when unset.
ASSISTANT_DAILY_QUOTA=50
# Product gate for the /assistant page + float widget. Closed rollout:
# hidden until explicitly opened (spec §10/§11).
# ASSISTANT_OPEN_CHAT=true

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Evidence (optional) ──────────────────────────────────────
# Used by lib/apollo.ts for external evidence lookup. Optional.
# APOLLO_API_KEY=your_apollo_api_key_here
